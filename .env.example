GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
RESEND_API_KEY=

# Optional secondary model tried once if the primary model fails with a
# transient error (503 overload, 429 quota, network/timeout). Leave unset
# to disable fallback entirely (primary-only, current behavior).
GEMINI_FALLBACK_MODEL=

# Canonical production origin, used only where an absolute URL is required
# server-side (email links, og:url/canonical) — never used for auth
# redirects, which already derive from the request's own origin. Defaults
# to the local dev server when unset.
SITE_URL=http://localhost:8080

# Comma-separated allowlist gating /review (the diagnostics/QA route).
# Unset = /review is unreachable by anyone.
REVIEWER_EMAILS=

# TEMPORARY REVIEW-ONLY AUTH BYPASS — see src/lib/review-bypass.server.ts.
# Leave REVIEW_BYPASS_AUTH unset/false everywhere except a local/review
# environment. NEVER set this in real production secrets. Requires ALL
# THREE of these to activate; missing any one keeps normal auth unchanged.
REVIEW_BYPASS_AUTH=false
REVIEW_USER_EMAIL=
REVIEW_USER_PASSWORD=

# Mirror of SUPABASE_URL / SUPABASE_ANON_KEY above, exposed to the browser
# bundle (Vite only inlines VITE_-prefixed vars). Required for Google
# sign-in, which needs a browser-side Supabase client to redirect to
# Google. Safe to expose — it's the public anon key, protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
